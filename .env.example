# Required: your Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key isn't scoped to a workspace (the API will say so)
ANTHROPIC_WORKSPACE_ID=

# Optional settings
PORT=3000
HOST=0.0.0.0
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (lower = faster, cheaper replies)
CLAUDE_EFFORT=medium
# If set, the display asks for this passcode once before it can chat.
ACCESS_TOKEN=
# Optional: replaces the chat instructions (app-building rules are always added)
SYSTEM_PROMPT=
# Where apps Claude builds are saved when no Vercel Blob store is connected.
APPS_DIR=data/apps
# Set automatically on Vercel when you connect a Blob store:
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
